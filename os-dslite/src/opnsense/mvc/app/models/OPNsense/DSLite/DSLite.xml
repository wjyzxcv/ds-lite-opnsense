<model>
    <mount>//OPNsense/dslite</mount>
    <description>DS-Lite (Dual-Stack Lite) tunnel configuration</description>
    <version>1.1.0</version>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <mode type="OptionField">
            <Default>dslite</Default>
            <Required>Y</Required>
            <OptionValues>
                <dslite>DS-Lite (Shared IPv4 / CG-NAT)</dslite>
                <fixedip>Fixed IP (IPv4 over IPv6 IPIP)</fixedip>
                <mape>MAP-E (experimental)</mape>
            </OptionValues>
        </mode>
        <isp_profile type="OptionField">
            <Default>auto</Default>
            <Required>Y</Required>
            <OptionValues>
                <auto>Auto-detect (from prefix)</auto>
                <transix>Transix (Internet Multifeed)</transix>
                <xpass>Xpass (ARTERIA Networks)</xpass>
                <v6connect>v6 Connect (NTT Smart Connect)</v6connect>
                <enabler>Enabler (freebit)</enabler>
                <custom>Custom</custom>
            </OptionValues>
        </isp_profile>
        <wan_interface type="InterfaceField">
            <Required>Y</Required>
            <AllowDynamic>1</AllowDynamic>
            <filters>
                <enable>/^1$/</enable>
            </filters>
        </wan_interface>
        <aftr_address type="NetworkField">
            <Required>N</Required>
            <NetMaskAllowed>N</NetMaskAllowed>
            <AddressFamily>IPv6</AddressFamily>
        </aftr_address>
        <aftr_hostname type="HostnameField">
            <Required>N</Required>
        </aftr_hostname>
        <b4_address type="NetworkField">
            <Default>192.0.0.2</Default>
            <Required>Y</Required>
            <NetMaskAllowed>N</NetMaskAllowed>
            <AddressFamily>IPv4</AddressFamily>
        </b4_address>
        <aftr_v4_address type="NetworkField">
            <Default>192.0.0.1</Default>
            <Required>Y</Required>
            <NetMaskAllowed>N</NetMaskAllowed>
            <AddressFamily>IPv4</AddressFamily>
        </aftr_v4_address>
        <!--
            The gif unit the tunnel is built on. Pinned rather than allocated at
            runtime: OPNsense registers this interface and firewall/NAT rules
            reference it by name, so a unit that moved between reboots would
            repoint those rules at whatever else landed on the old name.
        -->
        <tunnel_interface type="TextField">
            <Default>gif0</Default>
            <Required>Y</Required>
            <Mask>/^gif[0-9]{1,2}$/</Mask>
            <ValidationMessage>Must be a gif unit name, for example gif0.</ValidationMessage>
        </tunnel_interface>
        <mtu type="IntegerField">
            <Default>1460</Default>
            <Required>Y</Required>
            <MinimumValue>576</MinimumValue>
            <MaximumValue>9000</MaximumValue>
        </mtu>
        <mss_clamp type="IntegerField">
            <Default>1420</Default>
            <Required>Y</Required>
            <MinimumValue>536</MinimumValue>
            <MaximumValue>8960</MaximumValue>
        </mss_clamp>
        <nat_enabled type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </nat_enabled>
        <fixedip_interface_id type="TextField">
            <Required>N</Required>
            <Mask>/^[0-9a-fA-F:]+$/</Mask>
        </fixedip_interface_id>
        <fixedip_aftr type="TextField">
            <Required>N</Required>
            <Mask>/^[0-9a-fA-F:]+$/</Mask>
        </fixedip_aftr>
        <fixedip_v4 type="NetworkField">
            <Required>N</Required>
            <NetMaskAllowed>N</NetMaskAllowed>
            <AddressFamily>IPv4</AddressFamily>
        </fixedip_v4>
        <fixedip_update_url type="UrlField">
            <Required>N</Required>
        </fixedip_update_url>
        <fixedip_auth_user type="TextField">
            <Required>N</Required>
        </fixedip_auth_user>
        <fixedip_auth_pass type="TextField">
            <Required>N</Required>
        </fixedip_auth_pass>
        <!--
            Credentials are never sent over an unverified connection by default.
            Some Japanese ISPs (notably OCN Fixed IP) only publish a plain-HTTP
            DynDNS-style nic/update endpoint, so this escape hatch exists; it is
            off unless the operator deliberately accepts the exposure.
        -->
        <fixedip_allow_insecure type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </fixedip_allow_insecure>
        <!--
            Xpass (ARTERIA Networks) uses a DDNS-style provisioning endpoint
            instead of standard HB46PP. These fields are only shown when
            isp_profile is "xpass" in Fixed IP mode.

            The update request format is:
              GET <update_url>?d=<fqdn>&p=<ddns_pass>&a=<CE-IPv6>&u=<ddns_id>
            with HTTP Basic auth using fixedip_auth_user/fixedip_auth_pass.
        -->
        <fixedip_ddns_id type="TextField">
            <Required>N</Required>
        </fixedip_ddns_id>
        <fixedip_ddns_pass type="TextField">
            <Required>N</Required>
        </fixedip_ddns_pass>
        <fixedip_fqdn type="HostnameField">
            <Required>N</Required>
        </fixedip_fqdn>
        <!--
            MAP-E (RFC 7597), experimental.

            A profile supplies only what is constant across an entire service
            (the BR address and the PSID offset). The Basic Mapping Rule below
            is per-subscriber: the VNEs do not publish their rule sets, so these
            cannot be shipped as a table and must come from the operator or from
            a rule calculator. Field names mirror the v6mig map_e schema so a
            provisioning client can populate them without a config migration.
        -->
        <mape_profile type="OptionField">
            <Default>custom</Default>
            <Required>N</Required>
            <OptionValues>
                <custom>Custom (enter all values)</custom>
                <v6plus>v6plus / JPNE</v6plus>
            </OptionValues>
        </mape_profile>
        <mape_br type="TextField">
            <Required>N</Required>
            <Mask>/^[0-9a-fA-F:]*$/</Mask>
            <ValidationMessage>Must be the BR IPv6 address.</ValidationMessage>
        </mape_br>
        <mape_rule_ipv6 type="TextField">
            <Required>N</Required>
            <Mask>/^([0-9a-fA-F:]+\/[0-9]{1,3})?$/</Mask>
            <ValidationMessage>Must be an IPv6 prefix in CIDR form, for example 240b:10::/31.</ValidationMessage>
        </mape_rule_ipv6>
        <mape_rule_ipv4 type="TextField">
            <Required>N</Required>
            <Mask>/^([0-9.]+\/[0-9]{1,2})?$/</Mask>
            <ValidationMessage>Must be an IPv4 prefix in CIDR form, for example 106.72.0.0/15.</ValidationMessage>
        </mape_rule_ipv4>
        <mape_ea_length type="IntegerField">
            <Required>N</Required>
            <MinimumValue>0</MinimumValue>
            <MaximumValue>48</MaximumValue>
        </mape_ea_length>
        <mape_psid_offset type="IntegerField">
            <Required>N</Required>
            <MinimumValue>0</MinimumValue>
            <MaximumValue>16</MaximumValue>
        </mape_psid_offset>
    </items>
</model>
